PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/videha-overseas-crm
JWT_SECRET=change-me-to-a-long-random-secret
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Resend Email Configuration (Reminders & OTP)
# Sign up at https://resend.com, generate an API key under API Keys, and verify your domain.
# In development/sandbox testing, you can use RESEND_FROM="Videha Overseas CRM <onboarding@resend.dev>"
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM="Videha Overseas CRM <notifications@videhaoverseas.com>"

# Finance reporting — INR conversion rates (1 unit of currency → INR)
USD_TO_INR=83
EUR_TO_INR=90
GBP_TO_INR=105
AED_TO_INR=22.6

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=dy331h8c5
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_CRM_FOLDER=crm
